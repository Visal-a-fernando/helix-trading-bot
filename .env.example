# HELIX is research/architecture only and needs no live keys to run the
# diagnostics. This template documents the trade-only pattern the architecture
# assumes IF you extend it toward paper/live. Copy to .env and fill locally.
# NEVER commit a real .env.

# Exchange API keys must be TRADE-ONLY, with withdrawals DISABLED.
# One scoped key per venue per bot instance.
EXCHANGE_API_KEY=your_trade_only_key_here
EXCHANGE_API_SECRET=your_secret_here

# Runtime mode: backtest | paper | live  (live requires dry-run validation first)
BOT_MODE=backtest
